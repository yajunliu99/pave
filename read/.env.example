# Copy to .env and fill in. Never commit .env.

# VLM (ASU CreateAI)
CREATEAI_TOKEN=
CREATEAI_API_URL=
# optional model override; default gpt6_astra / openai
CREATEAI_MODEL_NAME=
CREATEAI_MODEL_PROVIDER=

# Satellite imagery (Mapbox Static Images)
MAPBOX_TOKEN=

# Google Street View Static API (image requests are billed)
GSV_API_KEY=
