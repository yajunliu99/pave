# Copy to .env (git-ignored) or point --env-file / $VLM4SCENARIO_ENV_FILE at your own file.

# OpenAI-compatible Chat Completions API, for --backend openai
OPENAI_API_KEY=
# a model that accepts images (or pass --model)
OPENAI_MODEL=
# optional: another OpenAI-compatible server (default https://api.openai.com/v1)
OPENAI_BASE_URL=

# Mapbox Static Images API, only to fetch new site imagery (vlm4scenario/imagery.py)
MAPBOX_TOKEN=
