# Copy to .env (git-ignored) in this folder; read and edit both use it. Never commit .env.
# Variables already set in the environment take precedence; edit's --env-file names another file.

# Vision-language model, through any OpenAI-compatible Chat Completions API
OPENAI_API_KEY=
# a model that accepts images, as the API names it (a gateway may prefix the provider: vendor/model-name)
OPENAI_MODEL=
# optional: a server other than OpenAI's (default https://api.openai.com/v1)
OPENAI_BASE_URL=

# Satellite imagery (Mapbox Static Images API), to fetch imagery for a new site
MAPBOX_TOKEN=

# Google Street View Static API, for read's street views (image requests are billed; metadata requests are free)
GSV_API_KEY=
